{
  "expo": {
    "name": "TrackoBus",
    "slug": "trackobus-frontend",
    "owner": "sm32",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/trcklogo.png",
    "scheme": "trackobusfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sm32.trackobus",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Allow TrackoBus to access your location to show nearby buses and share your live location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow TrackoBus to use your location to share live tracking even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Allow TrackoBus to use your location to share live tracking even when the app is in the background."
      }
    },
    "android": {
      "package": "com.sm32.trackobus",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/trcklogo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/trcklogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TrackoBus to access your location to show nearby buses and share your live location.",
          "locationAlwaysAndWhenInUsePermission": "Allow TrackoBus to use your location to share live tracking even when the app is in the background.",
          "locationAlwaysPermission": "Allow TrackoBus to use your location to share live tracking even when the app is in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93a59e3b-e30c-431a-9acf-2118ec004a7a"
      }
    }
  }
}